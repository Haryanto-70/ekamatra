// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MITRA
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum LeadSource {
  BOOKING_FORM
  QUICK_CONTACT
  WHATSAPP_CLICK
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String   @unique
  passwordHash String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mitraProfile MitraProfile?
  bookings     Booking[]      @relation("CustomerBookings")
  reviews      Review[]

  @@index([role])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  createdAt DateTime  @default(now())
  services  Service[]
  leads     Lead[]
}

model MitraProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  bio             String?
  avatarUrl       String?
  city            String
  address         String?
  whatsappNumber  String
  isVerified      Boolean  @default(false)
  ratingAvg       Float    @default(0)
  reviewCount     Int      @default(0)
  yearsExperience Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services Service[]
  bookings Booking[]
  reviews  Review[]

  @@index([city])
  @@index([ratingAvg])
}

model Service {
  id          String       @id @default(cuid())
  mitraId     String
  mitra       MitraProfile @relation(fields: [mitraId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  title       String
  description String?
  priceMin    Int
  priceMax    Int
  priceUnit   String       @default("per-pekerjaan")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  bookings Booking[]

  @@index([categoryId])
  @@index([mitraId])
}

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id])
  mitraId         String
  mitra           MitraProfile  @relation(fields: [mitraId], references: [id])
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  scheduledAt     DateTime
  address         String
  notes           String?
  status          BookingStatus @default(PENDING)
  estimatedPriceMin Int
  estimatedPriceMax Int
  finalPrice      Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  review Review?

  @@index([status])
  @@index([mitraId])
  @@index([customerId])
}

model Review {
  id         String       @id @default(cuid())
  bookingId  String       @unique
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   User         @relation(fields: [customerId], references: [id])
  mitraId    String
  mitra      MitraProfile @relation(fields: [mitraId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime     @default(now())

  @@index([mitraId])
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  phone      String
  city       String?
  categoryId String?
  category   Category?  @relation(fields: [categoryId], references: [id])
  message    String?
  source     LeadSource @default(QUICK_CONTACT)
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}
